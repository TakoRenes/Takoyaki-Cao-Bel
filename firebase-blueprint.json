{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "A takoyaki roleplay character created by the stall master.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "artwork": {
          "type": "string",
          "maxLength": 900000
        },
        "avatar": {
          "type": "string",
          "maxLength": 900000
        },
        "coverImage": {
          "type": "string",
          "maxLength": 900000
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 300
        },
        "plot": {
          "type": "string",
          "maxLength": 5000
        },
        "personality": {
          "type": "string",
          "maxLength": 2000
        },
        "scenario": {
          "type": "string",
          "maxLength": 3000
        },
        "setting": {
          "type": "string",
          "maxLength": 1000
        },
        "relationship": {
          "type": "string",
          "maxLength": 500
        },
        "genre": {
          "type": "string",
          "maxLength": 60
        },
        "tags": {
          "type": "array"
        },
        "contentWarning": {
          "type": "string",
          "maxLength": 500
        },
        "creator": {
          "type": "string",
          "maxLength": 80
        },
        "playUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "is_spicy": {
          "type": "boolean"
        },
        "playCount": {
          "type": "number"
        },
        "viewCount": {
          "type": "number"
        },
        "favoriteCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["name", "status", "is_spicy"]
    },
    "UserBoxItem": {
      "title": "UserBoxItem",
      "description": "A favorited takoyaki character stored privately in a user's personal takeaway box.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "characterId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "characterId", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Customer feedback and review for the takoyaki stall.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "authorAvatar": {
          "type": "string",
          "maxLength": 900000
        },
        "isAnonymous": {
          "type": "boolean"
        },
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "comment": {
          "type": "string",
          "maxLength": 5000
        },
        "photos": {
          "type": "array"
        },
        "helpfulCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["authorName", "rating", "isAnonymous", "createdAt"]
    }
  },
  "firestore": {
    "/characters/{characterId}": {
      "schema": {
        "$ref": "#/entities/Character"
      },
      "description": "Stores takoyaki roleplay characters."
    },
    "/users/{userId}/box/{characterId}": {
      "schema": {
        "$ref": "#/entities/UserBoxItem"
      },
      "description": "Stores each authenticated user's private favorited characters in their personal Takoyaki Box."
    },
    "/feedbacks/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Stores customer reviews and ratings visible to all users server-wide."
    }
  }
}
